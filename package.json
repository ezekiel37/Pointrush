{
  "name": "pointrush",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:api": "npm run dev --workspace @pointrush/api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:db": "npm run test:db --workspace @pointrush/api",
    "db:generate": "npm run db:generate --workspace @pointrush/api",
    "db:migrate": "npm run db:migrate --workspace @pointrush/api",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
