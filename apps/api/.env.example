NODE_ENV=development
# Set only after the matching sponsor terms are published and displayed for acceptance.
# SPONSOR_TERMS_VERSION=
PORT=8080
CORS_ORIGINS=http://localhost:3000
# Local development only; use separate runtime and migration roles in production.
DATABASE_URL=postgresql://pointrush:pointrush_local@127.0.0.1:5432/pointrush
MIGRATION_DATABASE_URL=postgresql://pointrush:pointrush_local@127.0.0.1:5432/pointrush
DATABASE_SSL_MODE=disable-local
DATABASE_POOL_MAX=5
# Authentication remains disabled in development unless all required fields are configured.
# Required in production; supply real secrets through Secret Manager, never Git.
# AUTH_SECRET=
# AUTH_BASE_URL=https://api.your-domain.example
# EMAIL_FROM=accounts@your-domain.example
# Separate 32-byte random key, hex-encoded; same value on API and worker.
# AUTH_EMAIL_ENCRYPTION_KEY=
# Defaults to CORS_ORIGINS; use exact HTTPS frontend origins in production.
# AUTH_TRUSTED_ORIGINS=https://app.your-domain.example
# Global auth email request reservations per 24-hour window, independent of reward funds.
AUTH_EMAIL_DAILY_LIMIT=100
# Email worker only: provide DATABASE_URL, TLS/pool settings, queue encryption key
# and the delivery key. No AUTH_SECRET, EMAIL_FROM, origins or migration role needed.
# RESEND_API_KEY=
# CLI hard deadline including processing and cleanup; 1000-300000 ms.
EMAIL_WORKER_MAX_DURATION_MS=60000
# HTTP worker only: generate an independent random 32-byte hex secret.
# EMAIL_WORKER_TRIGGER_SECRET=
