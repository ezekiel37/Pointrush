          "name": "usernames_format_check",
          "value": "\"usernames\".\"username\" collate \"C\" ~ '^[a-z][a-z0-9_]{1,18}[a-z0-9]$' and position('__' in \"usernames\".\"username\") = 0"
        },
        "usernames_ownership_check": {
          "name": "usernames_ownership_check",
          "value": "(\n    (\"usernames\".\"account_id\" is null and not \"usernames\".\"is_current\" and \"usernames\".\"retired_at\" is null)\n    or (\"usernames\".\"account_id\" is not null and (\n      (\"usernames\".\"is_current\" and \"usernames\".\"retired_at\" is null)\n      or (not \"usernames\".\"is_current\" and \"usernames\".\"retired_at\" is not null and \"usernames\".\"retired_at\" >= \"usernames\".\"claimed_at\")\n    ))\n  ) and (not \"usernames\".\"is_current\" or \"usernames\".\"retired_at\" is null)"
        }
