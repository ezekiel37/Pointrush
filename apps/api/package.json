{
  "name": "@pointrush/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch -p tsconfig.json --onSuccess 'node --env-file-if-exists=.env dist/main.js'",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:db": "tsc -p tsconfig.test.json && node --test .test-dist/test/database/*.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate-cli.js",
    "email:work": "node --env-file-if-exists=.env dist/auth/email-worker-cli.js"
  },
  "dependencies": {
    "@better-auth/core": "1.7.6",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "better-auth": "1.7.6",
    "better-call": "1.4.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.3",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.30.0",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "@pointrush/contracts": "0.1.0"
  }
}
