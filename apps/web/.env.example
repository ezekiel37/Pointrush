# Browser-visible API origin only. Never put secrets in NEXT_PUBLIC_*.
# Use the same hostname locally (localhost for both, not localhost + 127.0.0.1).
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080
# Production web/API must share a schemeful site, e.g. app.example.com + api.example.com.
# Add the exact web origin to API CORS_ORIGINS and AUTH_TRUSTED_ORIGINS.

